# Copier ce fichier en .env.local et remplir avec vos vraies valeurs.
# .env.local n'est jamais commité (voir .gitignore).

# URL publique du site une fois déployé (sans slash final), utilisée pour
# générer le sitemap.xml et le robots.txt. À défaut, une valeur de secours
# est utilisée (voir app/sitemap.ts / app/robots.ts).
NEXT_PUBLIC_SITE_URL=

# Google AdSense — obtenu après validation de votre compte AdSense
# (nécessite du contenu déjà publié en ligne, cf README).
# Format : ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Amazon Associates (France) — obtenu après inscription et première vente validée.
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# ManoMano — programme d'affiliation via un réseau (ex: Awin, Effiliation).
# Renseigner ici le préfixe de redirection fourni par le réseau, l'URL cible
# étant ajoutée automatiquement à la fin (encodée).
NEXT_PUBLIC_MANOMANO_AFFILIATE_PREFIX=

# Decathlon — programme d'affiliation via Awin, affiché uniquement sur les
# projets de catégorie Vélo. Même mécanique de préfixe que ManoMano.
NEXT_PUBLIC_DECATHLON_AFFILIATE_PREFIX=

# Norauto — programme d'affiliation via Effiliation, affiché uniquement sur les
# projets de catégorie Auto & Moto. Même mécanique de préfixe que ManoMano.
NEXT_PUBLIC_NORAUTO_AFFILIATE_PREFIX=

# Boulanger — programme d'affiliation via Effiliation, affiché uniquement sur les
# projets de catégorie Électroménager et Domotique. Même mécanique de préfixe.
NEXT_PUBLIC_BOULANGER_AFFILIATE_PREFIX=

# Conforama — programme d'affiliation via Awin, affiché uniquement sur les
# projets de catégorie Ameublement. Même mécanique de préfixe.
NEXT_PUBLIC_CONFORAMA_AFFILIATE_PREFIX=

# Cdiscount — programme d'affiliation via Awin, marchand généraliste affiché sur
# les catégories sans spécialiste dédié (Maison, Jardin, Piscine, Électricité,
# Plomberie, Énergie). Même mécanique de préfixe.
NEXT_PUBLIC_CDISCOUNT_AFFILIATE_PREFIX=

# Darty — programme d'affiliation via Awin, affiché uniquement sur les projets de
# catégorie Électroménager et Domotique (en complément de Boulanger). Même
# mécanique de préfixe.
NEXT_PUBLIC_DARTY_AFFILIATE_PREFIX=
